@prefix vidbo: <http://vi.dbpedia.example.org/ontology/> .
@prefix vidbr: <http://vi.dbpedia.example.org/resource/> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix dbo:   <http://dbpedia.org/ontology/> .
@prefix geo:   <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix vann:  <http://purl.org/vocab/vann/> .

#################################################################################
#  ViDBpedia Ontology (vidbo)
#  Domain: Vietnamese history, geography and notable people
#  OWL 2 DL. Most axioms are inside the OWL 2 RL profile so that they can be
#  materialised by a rule engine (owlrl) for the SPARQL endpoint; the remaining
#  axioms (existential superclasses, qualified cardinalities) are used by
#  tableau reasoners (HermiT / Pellet in Protégé) for consistency checking.
#################################################################################

<http://vi.dbpedia.example.org/ontology/>
    a owl:Ontology ;
    owl:versionIRI <http://vi.dbpedia.example.org/ontology/1.0> ;
    owl:versionInfo "1.0" ;
    vann:preferredNamespacePrefix "vidbo" ;
    vann:preferredNamespaceUri "http://vi.dbpedia.example.org/ontology/" ;
    dct:title "ViDBpedia Ontology"@en , "Ontology DBpedia tiếng Việt"@vi ;
    dct:description """Ontology for a Vietnamese DBpedia built from Vietnamese Wikipedia infoboxes.
Covers persons (monarchs, royals, military commanders, office holders, writers), dynasties and states,
Vietnamese administrative units (including the 2025 reform that abolished the district level),
military conflicts and written works. Aligned with DBpedia, FOAF and schema.org."""@en ;
    dct:created "2026-10-08"^^xsd:date ;
    rdfs:seeAlso <http://dbpedia.org/ontology/> .

#################################################################################
#  1. CLASS HIERARCHY
#################################################################################

### ---------- Top level (pairwise disjoint) ----------

vidbo:Agent a owl:Class ;
    rdfs:label "Agent"@en , "Tác nhân"@vi ;
    rdfs:comment "Something that can act: a person or a group such as a dynasty."@en ;
    owl:equivalentClass dbo:Agent .

vidbo:Place a owl:Class ;
    rdfs:label "Place"@en , "Địa điểm"@vi ;
    owl:equivalentClass dbo:Place , schema:Place .

vidbo:Event a owl:Class ;
    rdfs:label "Event"@en , "Sự kiện"@vi ;
    owl:equivalentClass dbo:Event , schema:Event .

vidbo:Work a owl:Class ;
    rdfs:label "Work"@en , "Tác phẩm"@vi ;
    owl:equivalentClass dbo:Work , schema:CreativeWork .

vidbo:Tenure a owl:Class ;
    rdfs:label "Tenure"@en , "Nhiệm kỳ / thời gian tại vị"@vi ;
    rdfs:comment """N-ary relation pattern (W3C 'Defining N-ary Relations', ODP 'Situation'):
a period in which a person holds a position. Being a monarch or an office holder is a
non-rigid role (OntoClean), so it is reified instead of being modelled as a rigid subclass of Person."""@en .

# Persons are never places, events, works or tenures.
[] a owl:AllDisjointClasses ;
   owl:members ( vidbo:Person vidbo:Place vidbo:Event vidbo:Work vidbo:Tenure ) .
# Groups (dynasties) are deliberately NOT disjoint with Place: Wikipedia uses one article
# (e.g. "Nhà Nguyên") both for the ruling house and for the polity it ruled.
[] a owl:AllDisjointClasses ;
   owl:members ( vidbo:Group vidbo:Event vidbo:Work vidbo:Tenure ) .

### ---------- Agents ----------

vidbo:Person a owl:Class ;
    rdfs:subClassOf vidbo:Agent ;
    rdfs:label "Person"@en , "Người"@vi ;
    owl:equivalentClass dbo:Person , foaf:Person , schema:Person .

vidbo:Group a owl:Class ;
    rdfs:subClassOf vidbo:Agent ;
    rdfs:label "Group"@en , "Nhóm / tổ chức"@vi .

vidbo:Dynasty a owl:Class ;
    rdfs:subClassOf vidbo:Group ;
    rdfs:label "Dynasty"@en , "Triều đại / hoàng tộc"@vi ;
    rdfs:comment "A ruling family (e.g. Nhà Trần). Members are persons; the dynasty rules one or more states."@en ;
    rdfs:subClassOf dbo:Family .

vidbo:VietnameseDynasty a owl:Class ;
    rdfs:subClassOf vidbo:Dynasty ;
    rdfs:label "Vietnamese dynasty"@en , "Triều đại Việt Nam"@vi .

[] a owl:AllDisjointClasses ; owl:members ( vidbo:Person vidbo:Group ) .

### ---------- Roles of persons (defined classes: membership is INFERRED) ----------

vidbo:Monarch a owl:Class ;
    rdfs:label "Monarch"@en , "Quân chủ / vua"@vi ;
    rdfs:comment "Defined class: a person who has at least one reign."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:Person
                           [ a owl:Restriction ; owl:onProperty vidbo:hasReign ; owl:someValuesFrom vidbo:Reign ] ) ] ;
    rdfs:subClassOf dbo:Monarch .

vidbo:VietnameseMonarch a owl:Class ;
    rdfs:label "Vietnamese monarch"@en , "Vua Việt Nam"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:Monarch
                           [ a owl:Restriction ; owl:onProperty vidbo:memberOfDynasty ; owl:someValuesFrom vidbo:VietnameseDynasty ] ) ] .

vidbo:RoyalChild a owl:Class ;
    rdfs:label "Prince or princess"@en , "Hoàng tử / công chúa"@vi ;
    rdfs:comment "Defined class: a person having a monarch as parent."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:Person
                           [ a owl:Restriction ; owl:onProperty vidbo:hasParent ; owl:someValuesFrom vidbo:Monarch ] ) ] .

vidbo:RoyalFamilyMember a owl:Class ;
    rdfs:label "Member of a royal family"@en , "Thành viên hoàng tộc"@vi ;
    rdfs:comment "Monarchs, their children and their spouses (union expressed as three subclass axioms, OWL RL friendly)."@en .
vidbo:Monarch   rdfs:subClassOf vidbo:RoyalFamilyMember .
vidbo:RoyalChild rdfs:subClassOf vidbo:RoyalFamilyMember .
vidbo:RoyalTitleHolder rdfs:subClassOf vidbo:RoyalFamilyMember .

vidbo:RoyalTitleHolder a owl:Class ;
    rdfs:label "Royal title holder (consort, heir...)"@en , "Người giữ tước vị hoàng gia"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:Person
                           [ a owl:Restriction ; owl:onProperty vidbo:holdsRoyalTitle ; owl:someValuesFrom vidbo:RoyalTitleTenure ] ) ] .
[ a owl:Restriction ; owl:onProperty vidbo:spouse ; owl:someValuesFrom vidbo:Monarch ]
    rdfs:subClassOf vidbo:RoyalFamilyMember .

vidbo:OfficeHolder a owl:Class ;
    rdfs:label "Office holder"@en , "Người giữ chức vụ / chính khách"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:Person
                           [ a owl:Restriction ; owl:onProperty vidbo:holdsOffice ; owl:someValuesFrom vidbo:OfficeTenure ] ) ] ;
    rdfs:subClassOf dbo:Politician .

vidbo:RoyalCourtOfficial a owl:Class ;
    rdfs:label "Royal court official"@en , "Quan lại triều đình"@vi ;
    rdfs:comment "Defined class: an office holder who served under a monarch (chain holdsOffice ∘ underMonarch)."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:OfficeHolder
                           [ a owl:Restriction ; owl:onProperty vidbo:servedUnder ; owl:someValuesFrom vidbo:Monarch ] ) ] .

vidbo:MilitaryPerson a owl:Class ;
    rdfs:subClassOf vidbo:Person ;
    rdfs:label "Military person"@en , "Quân nhân"@vi ;
    owl:equivalentClass dbo:MilitaryPerson .

vidbo:MilitaryCommander a owl:Class ;
    rdfs:subClassOf vidbo:MilitaryPerson ;
    rdfs:label "Military commander"@en , "Chỉ huy quân sự"@vi ;
    rdfs:comment "Defined class: a person who commanded at least one military conflict."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:Person
                           [ a owl:Restriction ; owl:onProperty vidbo:commanded ; owl:someValuesFrom vidbo:MilitaryConflict ] ) ] .

vidbo:MonarchWarrior a owl:Class ;
    rdfs:label "Warrior monarch"@en , "Vua trực tiếp cầm quân"@vi ;
    rdfs:comment "Defined class (intersection of two defined classes): a monarch who also commanded in a conflict."@en ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:Monarch vidbo:MilitaryCommander ) ] .

vidbo:Writer a owl:Class ;
    rdfs:subClassOf vidbo:Person ;
    rdfs:label "Writer"@en , "Nhà văn / nhà thơ"@vi ;
    owl:equivalentClass dbo:Writer .
[ a owl:Restriction ; owl:onProperty vidbo:notableWork ; owl:someValuesFrom vidbo:WrittenWork ]
    rdfs:subClassOf vidbo:Writer .

vidbo:NationalHero a owl:Class ;
    rdfs:subClassOf vidbo:Person ;
    rdfs:label "National hero"@en , "Anh hùng dân tộc"@vi .

vidbo:CentenarianPerson a owl:Class ;
    rdfs:subClassOf vidbo:Person ;
    rdfs:label "Centenarian"@en , "Người sống thọ trên 100 tuổi"@vi ;
    rdfs:comment "Populated by the rule layer (rules/*.rq) from birth and death dates: OWL cannot do date arithmetic."@en .

### ---------- Places ----------

vidbo:PopulatedPlace a owl:Class ;
    rdfs:subClassOf vidbo:Place ;
    rdfs:label "Populated place"@en , "Khu dân cư"@vi ;
    owl:equivalentClass dbo:PopulatedPlace .

vidbo:State a owl:Class ;
    rdfs:subClassOf vidbo:PopulatedPlace ;
    rdfs:label "State / country"@en , "Quốc gia"@vi ;
    owl:equivalentClass dbo:Country .

vidbo:FormerState a owl:Class ;
    rdfs:subClassOf vidbo:State ;
    rdfs:label "Former state"@en , "Cựu quốc gia"@vi ;
    rdfs:comment "Defined (sufficient condition): a state with a dissolution year."@en .
[ a owl:Class ; owl:intersectionOf ( vidbo:State
    [ a owl:Restriction ; owl:onProperty vidbo:dissolutionYear ; owl:someValuesFrom rdfs:Literal ] ) ]
    rdfs:subClassOf vidbo:FormerState .

vidbo:Region a owl:Class ;
    rdfs:subClassOf vidbo:Place ;
    rdfs:label "Region"@en , "Vùng"@vi .

vidbo:AdministrativeUnit a owl:Class ;
    rdfs:subClassOf vidbo:PopulatedPlace ;
    rdfs:label "Vietnamese administrative unit"@en , "Đơn vị hành chính Việt Nam"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:unionOf ( vidbo:FirstLevelUnit vidbo:SecondLevelUnit vidbo:ThirdLevelUnit ) ] ;
    rdfs:subClassOf dbo:AdministrativeRegion ;
    owl:hasKey ( vidbo:adminCode ) .

# Levels are DEFINED by the value of vidbo:adminLevel (hasValue restrictions, OWL RL compatible)
vidbo:FirstLevelUnit a owl:Class ;
    rdfs:label "First-level unit (province / municipality)"@en , "Đơn vị hành chính cấp tỉnh"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:AdministrativeUnit
        [ a owl:Restriction ; owl:onProperty vidbo:adminLevel ; owl:hasValue 1 ] ) ] .
vidbo:SecondLevelUnit a owl:Class ;
    rdfs:label "Second-level unit (district, abolished 1 July 2025)"@en , "Đơn vị hành chính cấp huyện"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:AdministrativeUnit
        [ a owl:Restriction ; owl:onProperty vidbo:adminLevel ; owl:hasValue 2 ] ) ] .
vidbo:ThirdLevelUnit a owl:Class ;
    rdfs:label "Third-level unit (commune / ward / special zone)"@en , "Đơn vị hành chính cấp xã"@vi ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( vidbo:AdministrativeUnit
        [ a owl:Restriction ; owl:onProperty vidbo:adminLevel ; owl:hasValue 3 ] ) ] .

[] a owl:AllDisjointClasses ;
   owl:members ( vidbo:FirstLevelUnit vidbo:SecondLevelUnit vidbo:ThirdLevelUnit ) .

vidbo:Province     a owl:Class ; rdfs:subClassOf vidbo:FirstLevelUnit ; rdfs:label "Province"@en , "Tỉnh"@vi ; owl:equivalentClass dbo:Province .
vidbo:Municipality a owl:Class ; rdfs:subClassOf vidbo:FirstLevelUnit ; rdfs:label "Centrally-governed city"@en , "Thành phố trực thuộc trung ương"@vi .
vidbo:District     a owl:Class ; rdfs:subClassOf vidbo:SecondLevelUnit ; rdfs:label "District-level unit"@en , "Huyện / quận / thị xã / thành phố thuộc tỉnh"@vi .
vidbo:Commune      a owl:Class ; rdfs:subClassOf vidbo:ThirdLevelUnit ; rdfs:label "Commune"@en , "Xã"@vi .
vidbo:Ward         a owl:Class ; rdfs:subClassOf vidbo:ThirdLevelUnit ; rdfs:label "Ward"@en , "Phường"@vi .
vidbo:Township     a owl:Class ; rdfs:subClassOf vidbo:ThirdLevelUnit ; rdfs:label "Township"@en , "Thị trấn"@vi .
vidbo:SpecialZone  a owl:Class ; rdfs:subClassOf vidbo:ThirdLevelUnit ; rdfs:label "Special zone"@en , "Đặc khu"@vi .
[] a owl:AllDisjointClasses ; owl:members ( vidbo:Province vidbo:Municipality ) .
[] a owl:AllDisjointClasses ; owl:members ( vidbo:Commune vidbo:Ward vidbo:Township vidbo:SpecialZone ) .

vidbo:HistoricalAdministrativeUnit a owl:Class ;
    rdfs:subClassOf vidbo:AdministrativeUnit ;
    rdfs:label "Historical (abolished) administrative unit"@en , "Đơn vị hành chính đã giải thể"@vi ;
    rdfs:comment "Domain knowledge: Resolution 202/2025/QH15 and the 2025 Constitution amendment abolished the district level from 1 July 2025."@en .
vidbo:SecondLevelUnit rdfs:subClassOf vidbo:HistoricalAdministrativeUnit .
[ a owl:Restriction ; owl:onProperty vidbo:mergedInto ; owl:someValuesFrom vidbo:AdministrativeUnit ]
    rdfs:subClassOf vidbo:HistoricalAdministrativeUnit .

# Existential axiom (not RL; checked by HermiT): every 3rd-level unit lies in some 1st-level unit
vidbo:ThirdLevelUnit rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty vidbo:locatedIn ; owl:someValuesFrom vidbo:FirstLevelUnit ] .

### ---------- Events ----------

vidbo:MilitaryConflict a owl:Class ;
    rdfs:subClassOf vidbo:Event ;
    rdfs:label "Military conflict"@en , "Xung đột quân sự"@vi ;
    owl:equivalentClass dbo:MilitaryConflict ;
    # qualified cardinality (OWL 2 DL): a conflict has at least two belligerents
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty vidbo:combatant ;
                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass vidbo:Belligerent ] .

vidbo:Belligerent a owl:Class ;
    rdfs:label "Belligerent"@en , "Bên tham chiến"@vi ;
    rdfs:comment "A party in a conflict: an agent (dynasty, army, person) or a state."@en ;
    owl:equivalentClass [ a owl:Class ; owl:unionOf ( vidbo:Agent vidbo:State ) ] .

vidbo:War      a owl:Class ; rdfs:subClassOf vidbo:MilitaryConflict ; rdfs:label "War"@en , "Chiến tranh / cuộc kháng chiến"@vi .
vidbo:Campaign a owl:Class ; rdfs:subClassOf vidbo:MilitaryConflict ; rdfs:label "Campaign"@en , "Chiến dịch"@vi .
vidbo:Battle   a owl:Class ; rdfs:subClassOf vidbo:MilitaryConflict ; rdfs:label "Battle"@en , "Trận đánh"@vi .
vidbo:Uprising a owl:Class ; rdfs:subClassOf vidbo:MilitaryConflict ; rdfs:label "Uprising"@en , "Khởi nghĩa"@vi .
[] a owl:AllDisjointClasses ; owl:members ( vidbo:War vidbo:Battle ) .

### ---------- Works ----------

vidbo:WrittenWork a owl:Class ;
    rdfs:subClassOf vidbo:Work ;
    rdfs:label "Written work"@en , "Tác phẩm văn học"@vi ;
    owl:equivalentClass dbo:WrittenWork .

### ---------- Tenures (n-ary pattern) ----------

vidbo:Reign a owl:Class ;
    rdfs:subClassOf vidbo:Tenure ;
    rdfs:label "Reign"@en , "Thời gian trị vì"@vi ;
    # Each reign belongs to exactly one person (OWL 2 qualified cardinality)
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty vidbo:reignOf ;
                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ; owl:onClass vidbo:Person ] .

vidbo:OfficeTenure a owl:Class ;
    rdfs:subClassOf vidbo:Tenure ;
    rdfs:label "Office tenure"@en , "Nhiệm kỳ chức vụ"@vi .

vidbo:RoyalTitleTenure a owl:Class ;
    rdfs:subClassOf vidbo:Tenure ;
    rdfs:label "Non-sovereign royal title tenure"@en , "Thời gian giữ tước vị (hậu phi, thái tử...)"@vi ;
    rdfs:comment "Consorts and heirs also have a 'tại vị' field in the royalty infobox, but they do not reign."@en .

[] a owl:AllDisjointClasses ; owl:members ( vidbo:Reign vidbo:OfficeTenure vidbo:RoyalTitleTenure ) .

#################################################################################
#  2. OBJECT PROPERTIES
#################################################################################

### ---------- Family (inverse, chains, transitive, symmetric, irreflexive) ----------

vidbo:hasParent a owl:ObjectProperty , owl:IrreflexiveProperty , owl:AsymmetricProperty ;
    rdfs:label "has parent"@en , "có cha/mẹ"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Person ;
    rdfs:subPropertyOf vidbo:hasAncestor ;
    owl:inverseOf vidbo:hasChild .

vidbo:hasChild a owl:ObjectProperty ;
    rdfs:label "has child"@en , "có con"@vi ;
    owl:equivalentProperty dbo:child .

vidbo:hasFather a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf vidbo:hasParent ;
    rdfs:label "father"@en , "cha"@vi ;
    owl:equivalentProperty dbo:father .

vidbo:hasMother a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf vidbo:hasParent ;
    rdfs:label "mother"@en , "mẹ"@vi ;
    owl:equivalentProperty dbo:mother .

vidbo:hasAncestor a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has ancestor"@en , "có tổ tiên"@vi ;
    owl:inverseOf vidbo:hasDescendant .
vidbo:hasDescendant a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "has descendant"@en , "có hậu duệ"@vi .

vidbo:hasGrandparent a owl:ObjectProperty ;
    rdfs:label "has grandparent"@en , "có ông/bà"@vi ;
    owl:propertyChainAxiom ( vidbo:hasParent vidbo:hasParent ) ;
    owl:inverseOf vidbo:hasGrandchild .
vidbo:hasGrandchild a owl:ObjectProperty ; rdfs:label "has grandchild"@en , "có cháu"@vi .

vidbo:hasPaternalGrandfather a owl:ObjectProperty ;
    rdfs:label "paternal grandfather"@en , "ông nội"@vi ;
    owl:propertyChainAxiom ( vidbo:hasFather vidbo:hasFather ) ;
    rdfs:subPropertyOf vidbo:hasGrandparent .

vidbo:spouse a owl:ObjectProperty , owl:SymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "spouse"@en , "phối ngẫu / vợ chồng"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Person ;
    owl:equivalentProperty dbo:spouse .

vidbo:sibling a owl:ObjectProperty , owl:SymmetricProperty , owl:IrreflexiveProperty ;
    rdfs:label "sibling"@en , "anh chị em ruột"@vi ;
    rdfs:comment "Materialised by rule R1 (shared parent, different person): OWL cannot express x ≠ y in a chain."@en ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Person .

vidbo:uncleOrAunt a owl:ObjectProperty ;
    rdfs:label "has uncle or aunt"@en , "có chú/bác/cô/dì"@vi ;
    owl:propertyChainAxiom ( vidbo:hasParent vidbo:sibling ) .

### ---------- Dynasty membership (patrilineal chain) ----------

vidbo:memberOfDynasty a owl:ObjectProperty ;
    rdfs:label "member of dynasty"@en , "thuộc hoàng tộc / triều đại"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Dynasty ;
    owl:inverseOf vidbo:dynastyMember ;
    rdfs:comment "Patrilineal: the child of a member (via the father) is a member: hasFather ∘ memberOfDynasty ⊑ memberOfDynasty."@en ;
    owl:propertyChainAxiom ( vidbo:hasFather vidbo:memberOfDynasty ) .
vidbo:dynastyMember a owl:ObjectProperty ; rdfs:label "dynasty member"@en , "thành viên"@vi .

vidbo:servedDynasty a owl:ObjectProperty ;
    rdfs:label "served dynasty"@en , "phục vụ triều đại"@vi ;
    rdfs:comment "A mandarin or general served a dynasty without being a member of the ruling family (≠ memberOfDynasty)."@en ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Dynasty .

vidbo:dynastyRuledState a owl:ObjectProperty ;
    rdfs:label "ruled state"@en , "cai trị quốc gia"@vi ;
    rdfs:domain vidbo:Dynasty ; rdfs:range vidbo:State .

### ---------- Reigns / offices (n-ary) ----------

vidbo:hasReign a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:label "has reign"@en , "có thời gian trị vì"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Reign ;
    owl:inverseOf vidbo:reignOf .
vidbo:reignOf a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label "reign of"@en , "trị vì của"@vi .

vidbo:holdsOffice a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:label "holds office"@en , "giữ chức vụ"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:OfficeTenure ;
    owl:inverseOf vidbo:officeHolder .
vidbo:officeHolder a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:label "office holder"@en , "người giữ chức"@vi .

vidbo:underMonarch a owl:ObjectProperty ;
    rdfs:label "under monarch"@en , "dưới triều vua"@vi ;
    rdfs:domain vidbo:OfficeTenure ; rdfs:range vidbo:Person .

vidbo:servedUnder a owl:ObjectProperty ;
    rdfs:label "served under"@en , "làm quan dưới thời"@vi ;
    rdfs:comment "holdsOffice ∘ underMonarch ⊑ servedUnder"@en ;
    owl:propertyChainAxiom ( vidbo:holdsOffice vidbo:underMonarch ) ;
    owl:inverseOf vidbo:servedBy .
vidbo:servedBy a owl:ObjectProperty ; rdfs:label "served by"@en , "có bề tôi"@vi .

vidbo:holdsRoyalTitle a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:label "holds royal title"@en , "giữ tước vị"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:RoyalTitleTenure .

vidbo:position a owl:ObjectProperty ;
    rdfs:label "position / office"@en , "chức vị"@vi ;
    rdfs:domain vidbo:Tenure .

vidbo:tenureDynasty a owl:ObjectProperty ;
    rdfs:label "dynasty of reign"@en , "triều đại của thời kỳ trị vì"@vi ;
    rdfs:domain vidbo:Reign ; rdfs:range vidbo:Dynasty .

# A person whose reign belongs to dynasty D is a member of D:  hasReign ∘ tenureDynasty ⊑ memberOfDynasty
vidbo:ruledAsMemberOf a owl:ObjectProperty ;
    rdfs:subPropertyOf vidbo:memberOfDynasty ;
    owl:propertyChainAxiom ( vidbo:hasReign vidbo:tenureDynasty ) .

vidbo:predecessor a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:label "predecessor"@en , "tiền nhiệm"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Person ;
    owl:inverseOf vidbo:successor ;
    rdfs:comment """Deliberately NOT transitive: in the infoboxes the predecessor of a person is given per office,
and one person holds many offices, so a transitive closure would connect almost every office holder
with every other one (a first version did this and produced millions of meaningless triples)."""@en ;
    owl:equivalentProperty dbo:predecessor .
vidbo:successor a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:label "successor"@en , "kế nhiệm"@vi ;
    owl:equivalentProperty dbo:successor .

### ---------- Geography (transitive part-of, chains) ----------

vidbo:locatedIn a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "located in"@en , "nằm trong"@vi ;
    rdfs:domain vidbo:Place ; rdfs:range vidbo:Place ;
    owl:inverseOf vidbo:contains ;
    rdfs:subPropertyOf dbo:isPartOf .
vidbo:contains a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:label "contains"@en , "bao gồm"@vi .

vidbo:province a owl:ObjectProperty ;
    rdfs:subPropertyOf vidbo:locatedIn ;
    rdfs:label "province"@en , "tỉnh"@vi ;
    rdfs:range vidbo:FirstLevelUnit ;
    owl:equivalentProperty dbo:province .
vidbo:district a owl:ObjectProperty ;
    rdfs:subPropertyOf vidbo:locatedIn ;
    rdfs:label "district (before 1 July 2025)"@en , "huyện (trước 1/7/2025)"@vi ;
    rdfs:range vidbo:SecondLevelUnit .
vidbo:region a owl:ObjectProperty ;
    rdfs:subPropertyOf vidbo:locatedIn ;
    rdfs:label "region"@en , "vùng"@vi ;
    rdfs:range vidbo:Region .

vidbo:capital a owl:ObjectProperty ;
    rdfs:label "capital / seat"@en , "thủ phủ / tỉnh lỵ / kinh đô"@vi ;
    rdfs:domain vidbo:PopulatedPlace ; rdfs:range vidbo:Place ;
    owl:inverseOf vidbo:capitalOf ;
    owl:equivalentProperty dbo:capital .
vidbo:capitalOf a owl:ObjectProperty ;
    rdfs:label "capital of"@en , "là thủ phủ của"@vi ;
    rdfs:comment "Only used for administrative seats, which lie inside the unit: capitalOf ⊑ locatedIn."@en .

vidbo:seatOf a owl:ObjectProperty ;
    rdfs:subPropertyOf vidbo:capitalOf , vidbo:locatedIn ;
    rdfs:label "administrative seat of"@en , "là tỉnh lỵ của"@vi ;
    owl:inverseOf vidbo:adminSeat .
vidbo:adminSeat a owl:ObjectProperty ;
    rdfs:subPropertyOf vidbo:capital ;
    rdfs:label "administrative seat"@en , "tỉnh lỵ / huyện lỵ"@vi .

vidbo:mergedInto a owl:ObjectProperty ;
    rdfs:label "merged into"@en , "sáp nhập vào"@vi ;
    rdfs:domain vidbo:AdministrativeUnit ; rdfs:range vidbo:AdministrativeUnit ;
    owl:inverseOf vidbo:formedFrom .
vidbo:formedFrom a owl:ObjectProperty ;
    rdfs:label "formed from (former units)"@en , "hình thành từ (đơn vị cũ)"@vi .

vidbo:predecessorState a owl:ObjectProperty ;
    rdfs:label "preceded by state"@en , "quốc gia tiền thân"@vi ;
    rdfs:domain vidbo:State ; rdfs:range vidbo:State ;
    owl:inverseOf vidbo:successorState .
vidbo:successorState a owl:ObjectProperty ; rdfs:label "succeeded by state"@en , "quốc gia kế tục"@vi .

### ---------- Person - place ----------

vidbo:birthPlace a owl:ObjectProperty ;
    rdfs:label "birth place"@en , "nơi sinh"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Place ;
    rdfs:subPropertyOf vidbo:bornWithin ;
    owl:equivalentProperty dbo:birthPlace .
vidbo:deathPlace a owl:ObjectProperty ;
    rdfs:label "death place"@en , "nơi mất"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Place ;
    rdfs:subPropertyOf vidbo:diedWithin ;
    owl:equivalentProperty dbo:deathPlace .
vidbo:restingPlace a owl:ObjectProperty ;
    rdfs:label "resting place"@en , "nơi an táng"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Place ;
    owl:equivalentProperty dbo:restingPlace .

# birthPlace ∘ locatedIn* : "born somewhere inside X" (answers 'who was born in province X')
vidbo:bornWithin a owl:ObjectProperty ;
    rdfs:label "born within"@en , "sinh ra trong địa bàn"@vi ;
    owl:propertyChainAxiom ( vidbo:bornWithin vidbo:locatedIn ) .
vidbo:diedWithin a owl:ObjectProperty ;
    rdfs:label "died within"@en , "mất trong địa bàn"@vi ;
    owl:propertyChainAxiom ( vidbo:diedWithin vidbo:locatedIn ) .

vidbo:nationality a owl:ObjectProperty ;
    rdfs:label "nationality"@en , "quốc tịch"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:State .

### ---------- Military ----------

vidbo:commander a owl:ObjectProperty ;
    rdfs:label "commander"@en , "chỉ huy"@vi ;
    rdfs:domain vidbo:MilitaryConflict ; rdfs:range vidbo:Person ;
    owl:inverseOf vidbo:commanded ;
    owl:equivalentProperty dbo:commander .
vidbo:commanded a owl:ObjectProperty ;
    rdfs:label "commanded in"@en , "chỉ huy trong"@vi ;
    rdfs:subPropertyOf vidbo:participatedIn .

vidbo:combatant a owl:ObjectProperty ;
    rdfs:label "combatant"@en , "bên tham chiến"@vi ;
    rdfs:domain vidbo:MilitaryConflict ; rdfs:range vidbo:Belligerent .

vidbo:partOfConflict a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "part of conflict"@en , "là một phần của"@vi ;
    rdfs:domain vidbo:MilitaryConflict ; rdfs:range vidbo:MilitaryConflict ;
    owl:inverseOf vidbo:hasSubConflict ;
    rdfs:subPropertyOf dbo:isPartOfMilitaryConflict .
vidbo:hasSubConflict a owl:ObjectProperty , owl:TransitiveProperty ; rdfs:label "has sub-conflict"@en , "gồm trận/chiến dịch"@vi .

# Who fought in a battle also took part in the enclosing war:  participatedIn ∘ partOfConflict ⊑ participatedIn
vidbo:participatedIn a owl:ObjectProperty ;
    rdfs:label "participated in"@en , "tham gia"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:MilitaryConflict ;
    owl:propertyChainAxiom ( vidbo:participatedIn vidbo:partOfConflict ) .

vidbo:reignedDuringConflict a owl:ObjectProperty ;
    rdfs:label "reigned during conflict"@en , "trị vì trong thời gian diễn ra"@vi ;
    rdfs:comment "Rule-derived (rules/R6): a monarch whose reign interval contains the start year of a conflict fought by his dynasty or state."@en ;
    rdfs:domain vidbo:Monarch ; rdfs:range vidbo:MilitaryConflict .

vidbo:conflictPlace a owl:ObjectProperty ;
    rdfs:label "place of conflict"@en , "địa điểm"@vi ;
    rdfs:domain vidbo:MilitaryConflict ; rdfs:range vidbo:Place ;
    rdfs:subPropertyOf vidbo:tookPlaceWithin ;
    owl:equivalentProperty dbo:place .
vidbo:tookPlaceWithin a owl:ObjectProperty ;
    rdfs:label "took place within"@en , "diễn ra trong địa bàn"@vi ;
    owl:propertyChainAxiom ( vidbo:tookPlaceWithin vidbo:locatedIn ) .

### ---------- Works ----------

vidbo:notableWork a owl:ObjectProperty ;
    rdfs:label "notable work"@en , "tác phẩm tiêu biểu"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Work ;
    owl:inverseOf vidbo:author ;
    owl:equivalentProperty dbo:notableWork .
vidbo:author a owl:ObjectProperty ; rdfs:label "author"@en , "tác giả"@vi .

vidbo:influencedBy a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:label "influenced by"@en , "chịu ảnh hưởng của"@vi ;
    rdfs:domain vidbo:Person ; rdfs:range vidbo:Person ;
    owl:inverseOf vidbo:influenced ;
    rdfs:subPropertyOf vidbo:intellectualLineage ;
    owl:equivalentProperty dbo:influencedBy .
vidbo:influenced a owl:ObjectProperty ;
    rdfs:label "influenced"@en , "có ảnh hưởng tới"@vi ;
    owl:equivalentProperty dbo:influenced .
vidbo:intellectualLineage a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "intellectual lineage (transitive influence)"@en , "dòng ảnh hưởng tư tưởng (bắc cầu)"@vi .

### ---------- States ----------

vidbo:leader a owl:ObjectProperty ;
    rdfs:label "leader"@en , "nguyên thủ / lãnh đạo"@vi ;
    rdfs:domain vidbo:State ; rdfs:range vidbo:Person ;
    owl:inverseOf vidbo:leaderOf .
vidbo:leaderOf a owl:ObjectProperty ; rdfs:label "leader of"@en , "lãnh đạo của"@vi .
vidbo:governmentType a owl:DatatypeProperty ; rdfs:label "government type"@en , "chính thể"@vi ; rdfs:domain vidbo:State .

### ---------- Generic links (DBpedia style) ----------

vidbo:wikiPageWikiLink a owl:ObjectProperty ;
    rdfs:label "Link from a Wikipedia infobox to another page"@en , "liên kết trong hộp thông tin"@vi .

vidbo:religion a owl:ObjectProperty ; rdfs:label "religion"@en , "tôn giáo"@vi ; owl:equivalentProperty dbo:religion .

#################################################################################
#  3. DATATYPE PROPERTIES
#################################################################################

# xsd:date and xsd:gYear are NOT in the OWL 2 datatype map, so they cannot be used as
# rdfs:range in an OWL 2 DL ontology (HermiT rejects them). Values are still typed
# xsd:date / xsd:gYear in the data (exactly like DBpedia); the expected datatype is
# recorded with this annotation and ENFORCED by the SHACL shapes (ontology/shapes.ttl).
vidbo:expectedDatatype a owl:AnnotationProperty ;
    rdfs:label "expected datatype (checked by SHACL)"@en , "kiểu dữ liệu mong đợi (kiểm tra bằng SHACL)"@vi .

vidbo:birthDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "birth date"@en , "ngày sinh"@vi ; rdfs:domain vidbo:Person ; vidbo:expectedDatatype xsd:date ;
    owl:equivalentProperty dbo:birthDate .
vidbo:deathDate a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "death date"@en , "ngày mất"@vi ; rdfs:domain vidbo:Person ; vidbo:expectedDatatype xsd:date ;
    owl:equivalentProperty dbo:deathDate .
vidbo:birthYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "birth year"@en , "năm sinh"@vi ; rdfs:domain vidbo:Person ; vidbo:expectedDatatype xsd:gYear ;
    owl:equivalentProperty dbo:birthYear .
vidbo:deathYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "death year"@en , "năm mất"@vi ; rdfs:domain vidbo:Person ; vidbo:expectedDatatype xsd:gYear ;
    owl:equivalentProperty dbo:deathYear .

vidbo:birthName      a owl:DatatypeProperty ; rdfs:label "birth name"@en , "tên khai sinh / tên húy"@vi ; rdfs:domain vidbo:Person ; owl:equivalentProperty dbo:birthName .
vidbo:penName        a owl:DatatypeProperty ; rdfs:label "pen name"@en , "bút danh"@vi ; rdfs:domain vidbo:Person ; owl:equivalentProperty dbo:pseudonym .
vidbo:templeName     a owl:DatatypeProperty ; rdfs:label "temple name"@en , "miếu hiệu"@vi ; rdfs:domain vidbo:Person ;
    rdfs:comment "Domain is Person, not Monarch: consorts and princes also receive temple/posthumous names; a Monarch domain made 925 queens and princes into monarchs."@en .
vidbo:posthumousName a owl:DatatypeProperty ; rdfs:label "posthumous name"@en , "thụy hiệu"@vi ; rdfs:domain vidbo:Person ;
    rdfs:comment "Domain is Person, not Monarch: consorts and princes also receive temple/posthumous names; a Monarch domain made 925 queens and princes into monarchs."@en .
vidbo:eraName        a owl:DatatypeProperty ; rdfs:label "era name"@en , "niên hiệu"@vi ; rdfs:domain vidbo:Person ;
    rdfs:comment "Domain is Person, not Monarch: consorts and princes also receive temple/posthumous names; a Monarch domain made 925 queens and princes into monarchs."@en .
vidbo:courtesyName   a owl:DatatypeProperty ; rdfs:label "courtesy name"@en , "tên tự"@vi ; rdfs:domain vidbo:Person .
vidbo:publicationYear a owl:DatatypeProperty ; rdfs:label "publication year"@en , "năm xuất bản"@vi ; rdfs:domain vidbo:Work ;
    vidbo:expectedDatatype xsd:gYear .
vidbo:nativeName     a owl:DatatypeProperty ; rdfs:label "native-script name (Hán/Nôm)"@en , "tên chữ Hán/Nôm"@vi .
vidbo:title          a owl:DatatypeProperty ; rdfs:label "title (text)"@en , "tước vị / danh hiệu"@vi .
vidbo:rank           a owl:DatatypeProperty ; rdfs:label "military rank"@en , "quân hàm"@vi ; rdfs:domain vidbo:MilitaryPerson .
vidbo:serviceYears   a owl:DatatypeProperty ; rdfs:label "years of service"@en , "thời gian phục vụ"@vi .
vidbo:occupation     a owl:DatatypeProperty ; rdfs:label "occupation (text)"@en , "nghề nghiệp"@vi .

vidbo:startDate a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label "start date"@en , "ngày bắt đầu"@vi ; vidbo:expectedDatatype xsd:date .
vidbo:endDate   a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label "end date"@en , "ngày kết thúc"@vi ; vidbo:expectedDatatype xsd:date .
vidbo:startYear a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label "start year"@en , "năm bắt đầu"@vi ; vidbo:expectedDatatype xsd:gYear .
vidbo:endYear   a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label "end year"@en , "năm kết thúc"@vi ; vidbo:expectedDatatype xsd:gYear .
vidbo:durationYears a owl:DatatypeProperty ; rdfs:label "duration in years (rule-derived)"@en , "số năm (suy ra bằng luật)"@vi ; rdfs:range xsd:decimal .
vidbo:ageAtDeath a owl:DatatypeProperty ; rdfs:label "age at death (rule-derived)"@en , "hưởng thọ (suy ra bằng luật)"@vi ; rdfs:domain vidbo:Person ; rdfs:range xsd:integer .

vidbo:adminLevel a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "administrative level (1 = province, 2 = district, 3 = commune)"@en , "cấp hành chính"@vi ;
    rdfs:domain vidbo:AdministrativeUnit ; rdfs:range xsd:integer .
vidbo:adminCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "administrative code"@en , "mã hành chính"@vi ; rdfs:domain vidbo:AdministrativeUnit ; rdfs:range xsd:string .
vidbo:area a owl:DatatypeProperty ;
    rdfs:label "area (km²)"@en , "diện tích (km²)"@vi ; rdfs:domain vidbo:Place ; rdfs:range xsd:decimal .
vidbo:population a owl:DatatypeProperty ;
    rdfs:label "population"@en , "dân số"@vi ; rdfs:domain vidbo:PopulatedPlace ; rdfs:range xsd:integer ;
    owl:equivalentProperty dbo:populationTotal .
vidbo:populationAsOf a owl:DatatypeProperty ; rdfs:label "population as of"@en , "thời điểm dân số"@vi .
vidbo:populationDensity a owl:DatatypeProperty ; rdfs:label "population density (rule-derived, per km²)"@en , "mật độ dân số"@vi ; rdfs:range xsd:decimal .
vidbo:postalCode a owl:DatatypeProperty ; rdfs:label "postal code"@en , "mã bưu chính"@vi ; owl:equivalentProperty dbo:postalCode .
vidbo:areaCode   a owl:DatatypeProperty ; rdfs:label "telephone area code"@en , "mã điện thoại"@vi ; owl:equivalentProperty dbo:areaCode .
vidbo:licensePlate a owl:DatatypeProperty ; rdfs:label "vehicle plate code"@en , "biển số xe"@vi .
vidbo:isoCode    a owl:DatatypeProperty ; rdfs:label "ISO 3166-2 code"@en , "mã ISO 3166-2"@vi .
vidbo:foundingYear a owl:DatatypeProperty ; rdfs:label "founding year"@en , "năm thành lập"@vi ; vidbo:expectedDatatype xsd:gYear ; owl:equivalentProperty dbo:foundingYear .
vidbo:foundingDate a owl:DatatypeProperty ; rdfs:label "founding date"@en , "ngày thành lập"@vi ; vidbo:expectedDatatype xsd:date .
vidbo:dissolutionYear a owl:DatatypeProperty ; rdfs:label "dissolution year"@en , "năm giải thể"@vi ; vidbo:expectedDatatype xsd:gYear ; owl:equivalentProperty dbo:dissolutionYear .
vidbo:formerName a owl:DatatypeProperty ; rdfs:label "former name"@en , "tên cũ"@vi .
vidbo:ethnicGroups a owl:DatatypeProperty ; rdfs:label "ethnic groups (text)"@en , "dân tộc"@vi .
vidbo:leaderName a owl:DatatypeProperty ; rdfs:label "chairman of people's committee"@en , "chủ tịch UBND"@vi .
vidbo:website a owl:DatatypeProperty ; rdfs:label "website"@en , "trang web"@vi .

vidbo:result a owl:DatatypeProperty ; rdfs:label "result"@en , "kết quả"@vi ; rdfs:domain vidbo:MilitaryConflict .
vidbo:strength a owl:DatatypeProperty ; rdfs:label "strength (text)"@en , "lực lượng"@vi ; rdfs:domain vidbo:MilitaryConflict .
vidbo:casualties a owl:DatatypeProperty ; rdfs:label "casualties (text)"@en , "thương vong"@vi ; rdfs:domain vidbo:MilitaryConflict .

vidbo:abstract a owl:DatatypeProperty ; rdfs:label "abstract"@en , "tóm tắt"@vi ; owl:equivalentProperty dbo:abstract .
vidbo:wikiPageID a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:label "Wikipedia page ID"@en ; rdfs:range xsd:integer .
vidbo:wikiPageRevisionID a owl:DatatypeProperty ; rdfs:label "Wikipedia revision ID"@en ; rdfs:range xsd:integer .
vidbo:wikidataID a owl:DatatypeProperty ; rdfs:label "Wikidata QID"@en .
vidbo:infoboxTemplate a owl:DatatypeProperty ; rdfs:label "source infobox template"@en , "bản mẫu nguồn"@vi .

#################################################################################
#  4. A FEW SCHEMA-LEVEL INDIVIDUALS
#################################################################################

vidbr:Việt_Nam a vidbo:State ;
    rdfs:label "Việt Nam"@vi , "Vietnam"@en .
