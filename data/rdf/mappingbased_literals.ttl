vidbr:Đảo_chính_Ukraina_\(1918\) vidbo:casualties "3 chết"@vi,
        "Không có thương vong"@vi ;
    vidbo:result "Cuộc đảo chính thành công, Cộng hòa Nhân dân Ukraina bị giải thể, Quốc gia Ukraina được thành lập, Pavlo Skoropadskyi trở thành Hetman, Sự khôi phục của chế độ tá điền tại Ukraina"@vi ;
    vidbo:startDate "1918-04-30"^^xsd:date ;
    vidbo:startYear "1918"^^xsd:gYear ;
