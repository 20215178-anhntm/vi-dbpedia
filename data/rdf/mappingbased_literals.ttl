vidbr:Đảo_chính_Việt_Nam_Cộng_hòa_1960 vidbo:casualties "Không rõ, 400 chết ở cả hai phía"@vi ;
    vidbo:result "Cuộc đảo chính thất bại"@vi ;
    vidbo:startDate "1960-11-11"^^xsd:date ;
    vidbo:startYear "1960"^^xsd:gYear ;
    vidbo:strength "Một Trung đoàn Thiết giáp, một đơn vị Thủy quân, và ba Trung đoàn lính Nhảy dù"@vi,
        "Sư đoàn số 5 và Sư đoàn số 7 thuộc ARVN"@vi .

vidbr:Đảo_chính_Việt_Nam_Cộng_hòa_1963 vidbo:casualties "5 chết, 46 bị thương"@vi,
        "9 chết, 44 bị thương, 2 bị bắt"@vi,
        "Dân thường: 20 chết, 146 bị thương"@vi ;
    vidbo:endDate "1963-11-02"^^xsd:date ;
    vidbo:endYear "1963"^^xsd:gYear ;
    vidbo:result "Phe đảo chính chiến thắng, Kết thúc quyền lực gia đình họ Ngô và Đảng Cần lao Nhân vị, Tổng thống Đệ Nhất Việt Nam Cộng hòa Ngô Đình Diệm, cố vấn tối cao Ngô Đình Nhu bị giết, cố vấn miền trung Ngô Đình Cẩn bị kết án tử hình. Các thành viên còn lại của gia đình họ Ngô phải sang nước ngoài tị nạn lưu vong, Các tướng lĩnh và Hội đồng Quân nhân Cách mạng lên nắm quyền"@vi ;
    vidbo:startYear "0001"^^xsd:gYear ;
    vidbo:strength "2 Tiểu đoàn bộ binh thuộc Sư đoàn 5, 2 Tiểu đoàn Thủy quân Lục chiến, 2 Tiểu đoàn Nhảy dù, Một số đơn vị tân binh huấn luyện Không quân"@vi,
        "~150 quân thuộc Lữ đoàn Phòng vệ Phủ Tổng thống, Không rõ số lượng Lực lượng Đặc biệt"@vi .

