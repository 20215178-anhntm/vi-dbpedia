vidbr:Đại_chiến_Bắc_Âu vidbo:casualties "Khoảng 200, 000:, 25, 000 tử trận, 175, 000 chết do nạn đói, bệnh tật và kiệt sức (bao gồm hơn 40, 000 lính Phần Lan tử trận và nhiều lý do khác)"@vi,
        "Khoảng 200, 000:, 30, 000 lính Nga tử trận, bị thương và bị bắt trong trận chiến, 110, 000 chết do nạn đói, bệnh tật và kiệt sức, 14, 000–20, 000 lính Ba Lan, Saxons và 8, 000 lính Đan Mạch tử trận trong các trận chiến lớn từ 1709–1719"@vi ;
    vidbo:endDate "1721-09-10"^^xsd:date ;
    vidbo:endYear "1721"^^xsd:gYear ;
    vidbo:result "Phe liên minh giành chiến thắng:, Sa quốc Nga đã tự trở thành một cường quốc mới ở châu Âu, Đế quốc Thụy Điển và Liên bang Ba Lan và Lietuva suy tàn"@vi ;
    vidbo:startDate "1700-02-22"^^xsd:date ;
    vidbo:startYear "1700"^^xsd:gYear ;
    vidbo:strength "Đế quốc Nga:, 110, 000, Cossack Hetmanate:, 30, 000, Saxony:, 30, 000, Thịnh vượng chung Ba Lan–Lithuanian:, 50, 000, Đan Mạch–Na Uy:, 40, 000, Phổ:, 50, 000, Hanover:, 20, 000, Tổng:, 340, 000"@vi,
        "Đế quốc Thụy Điển:, 76, 000, Holstein-Gottorp:, 5, 000, Brunswick-Lüneburg:, 10, 000, Liên minh Warsaw:, 24, 000, Đế quốc Ottoman:, 130, 000, Cossack Hetmanate:, 4, 000, Cộng hòa Hà Lan:, 13 thuyền phòng tuyến, Anh:, 12 thuyền phòng tuyến, Tổng:, 249, 000, 25 thuyền phòng tuyến"@vi .

vidbr:Đại_chiến_Thổ_Nhĩ_Kỳ vidbo:casualties "384.000 binh sĩ chết ở tất cả các bên (120.000 người thiệt mạng và 180.000 người bị thương trong chiến đấu; các trường hợp tử vong khác hầu hết do bệnh tật)"@vi ;
